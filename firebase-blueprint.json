{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Learner profile, XP, streak, and completed lesson IDs for Kotoba.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Firebase Auth UID of the learner."
        },
        "displayName": {
          "type": "string",
          "description": "Learner display name shown in greeting."
        },
        "targetLevel": {
          "type": "string",
          "enum": ["KANA", "N5", "N4", "N3"],
          "description": "Learner target JLPT stage."
        },
        "dailyGoal": {
          "type": "integer",
          "description": "Daily flashcard/study goal count."
        },
        "xp": {
          "type": "integer",
          "description": "Total experience points earned."
        },
        "streakDays": {
          "type": "integer",
          "description": "Consecutive active study days."
        },
        "lastStudyDay": {
          "type": "string",
          "description": "ISO local date string (YYYY-MM-DD) of last study activity."
        },
        "completedLessonIds": {
          "type": "array",
          "description": "List of completed curriculum lesson identifiers."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp (FieldValue.serverTimestamp())."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp (FieldValue.serverTimestamp())."
        }
      },
      "required": [
        "userId",
        "displayName",
        "targetLevel",
        "dailyGoal",
        "xp",
        "streakDays",
        "lastStudyDay",
        "completedLessonIds",
        "createdAt",
        "updatedAt"
      ]
    },
    "FlashcardProgress": {
      "title": "FlashcardProgress",
      "description": "Spaced repetition flashcard progress for a Japanese vocabulary, kana, or kanji item.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Firebase Auth UID of the card owner."
        },
        "itemId": {
          "type": "string",
          "description": "Curriculum item ID matching the document ID."
        },
        "japanese": {
          "type": "string",
          "description": "Japanese text (kana or kanji)."
        },
        "reading": {
          "type": "string",
          "description": "Hiragana/katakana reading."
        },
        "romaji": {
          "type": "string",
          "description": "Latin romaji pronunciation."
        },
        "arabicMeaning": {
          "type": "string",
          "description": "Arabic translation/meaning."
        },
        "level": {
          "type": "string",
          "enum": ["KANA", "N5", "N4", "N3"],
          "description": "JLPT/script stage."
        },
        "box": {
          "type": "integer",
          "description": "SRS mastery box level (0 to 10)."
        },
        "intervalDays": {
          "type": "integer",
          "description": "Current review interval in days."
        },
        "easeFactor": {
          "type": "number",
          "description": "SM-2 ease factor between 1.3 and 3.5."
        },
        "nextReviewAtMs": {
          "type": "integer",
          "description": "Epoch milliseconds when the card is next due."
        },
        "reviewCount": {
          "type": "integer",
          "description": "Total reviews completed for this card."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp (FieldValue.serverTimestamp())."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp (FieldValue.serverTimestamp())."
        }
      },
      "required": [
        "userId",
        "itemId",
        "japanese",
        "reading",
        "romaji",
        "arabicMeaning",
        "level",
        "box",
        "intervalDays",
        "easeFactor",
        "nextReviewAtMs",
        "reviewCount",
        "createdAt",
        "updatedAt"
      ]
    },
    "QuizResult": {
      "title": "QuizResult",
      "description": "Completed quiz attempt record for progress tracking.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Firebase Auth UID of the learner."
        },
        "level": {
          "type": "string",
          "enum": ["KANA", "N5", "N4", "N3", "MIXED"],
          "description": "Quiz level category."
        },
        "score": {
          "type": "integer",
          "description": "Number of correct answers."
        },
        "totalQuestions": {
          "type": "integer",
          "description": "Total questions in the quiz."
        },
        "xpEarned": {
          "type": "integer",
          "description": "XP awarded for this attempt."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp (FieldValue.serverTimestamp())."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp (FieldValue.serverTimestamp())."
        }
      },
      "required": [
        "userId",
        "level",
        "score",
        "totalQuestions",
        "xpEarned",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Per-user learner profile, XP, streak, and completed lesson IDs."
    },
    "/users/{userId}/flashcards/{cardId}": {
      "schema": { "$ref": "#/entities/FlashcardProgress" },
      "description": "Per-user SRS flashcard progress documents."
    },
    "/users/{userId}/quiz_results/{resultId}": {
      "schema": { "$ref": "#/entities/QuizResult" },
      "description": "Per-user completed quiz attempt history."
    }
  }
}
